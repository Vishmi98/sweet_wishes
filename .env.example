# Copy to .env and fill in. Never commit real keys.

# --- Google Maps Platform (https://console.cloud.google.com/google/maps-apis) ---
# Enable: Maps JavaScript API, Places API (New) and Routes API (billing must be on).

# Server key for road distances. Restrict it to the Routes API only.
GOOGLE_MAPS_API_KEY=AIzaSyBilTOz4z3uFxWIRAmgW6ua0aDQvK1d-MM

# Browser key for the map and address search. Restrict it to your website(s)
# (e.g. http://localhost:3000/* and https://your-domain/*) and to the
# Maps JavaScript API and Places API (New).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyBe4_XmWHzepk1_CzbFujoGUeswfmUZzWM

# Map ID for the draggable pin (Map Management > Create Map ID > JavaScript).
# Leave empty to use Google's DEMO_MAP_ID while testing.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=f64c92e385aab776d548e604

# --- Delivery pricing (whole LKR / km) ---
# Baked in at build time: rebuild/redeploy after changing these.
# Free delivery within this many km by road. Defaults to 2.
NEXT_PUBLIC_DELIVERY_FREE_KM=2
# Fee for the first km past the free zone. Defaults to 300.
NEXT_PUBLIC_DELIVERY_FIRST_KM_FEE=300
# Fee for each km after that. Required. Update it when fuel/electricity costs change.
NEXT_PUBLIC_DELIVERY_PER_KM_FEE=50
